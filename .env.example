# App
APP_ENV=development
APP_NAME=WaxStack
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# CORS: comma-separated browser origins allowed to call the API.
# In production set this to your deployed web origin.
CORS_ALLOW_ORIGINS=http://localhost:3000

# PostgreSQL
# On Railway, the Postgres plugin provides DATABASE_URL automatically as
# postgres://...  The app normalizes it to the psycopg driver form at runtime,
# so you can paste it as-is.
POSTGRES_DB=waxstack
POSTGRES_USER=waxstack
POSTGRES_PASSWORD=waxstack
DATABASE_URL=postgresql+psycopg://waxstack:waxstack@localhost:5432/waxstack

# --- Authentication (REQUIRED in production) ---
# Signs JWT access tokens. Must be a strong random value >= 32 bytes in prod.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-jwt-secret-change-me

# --- Secrets at rest (REQUIRED in production) ---
# Encrypts stored Discogs OAuth tokens. Any strong random string works.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=dev-insecure-token-key-change-me-0000000000=

# --- Redis (recommended in production) ---
# Stores transient OAuth request-token state so it survives restarts and works
# across replicas. When empty, an in-process fallback is used (dev only).
# Railway's Redis plugin provides REDIS_URL automatically.
REDIS_URL=

# --- Discogs ---
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_CALLBACK_URL=http://localhost:8000/api/v1/integrations/discogs/callback
DISCOGS_USER_AGENT=WaxStack/0.1
# Legacy OAuth temp secret; must be non-default in production.
DISCOGS_OAUTH_TEMP_SECRET=change-me-in-production

# --- AI (used in a later step) ---
OPENAI_API_KEY=

# --- Concerts ---
CONCERT_PROVIDER_API_KEY=
TICKETMASTER_API_KEY=

# --- Social login (Google / Facebook) ---
# Redirect URIs to register: <API_BASE_URL>/api/v1/auth/{google,facebook}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Anthropic AI (optional; features degrade gracefully without it) ---
ANTHROPIC_API_KEY=
AI_FAST_MODEL=claude-haiku-4-5
AI_RESEARCH_MODEL=claude-sonnet-5
AI_WEB_SEARCH_MAX_USES=3

# --- Trip planner (optional) ---
EXPEDIA_AFFILIATE_ID=
DEFAULT_GAS_PRICE_USD=3.50

# --- Affiliate / referral (optional) ---
TICKET_AFFILIATE_PROVIDER=
TICKET_AFFILIATE_ID=
CAR_AFFILIATE_PROVIDER=
CAR_AFFILIATE_ID=
RIDESHARE_PROVIDER=
RIDESHARE_REFERRAL_URL=
